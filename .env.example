# 저장소 (Upstash Redis / Vercel KV) — 없으면 메모리에 저장(재시작하면 사라짐, 개발용)
KV_REST_API_URL=
KV_REST_API_TOKEN=
# 로그인 토큰 서명 키 (없으면 KV 토큰에서 만듦)
AUTH_SECRET=

# 로그인 방식
GOOGLE_WEB_CLIENT_ID=
# 이메일 코드 로그인 (Resend)
RESEND_API_KEY=
AUTH_EMAIL_FROM=
# 개발용: 메일 대신 서버 로그에 코드 출력
AUTH_EMAIL_LOG_ONLY=
# 메일 제목에 쓰는 앱 이름
APP_NAME=

# 성인 본인인증 (포트원 V2)
ADULT_VERIFY_REQUIRED=0
PORTONE_API_SECRET=
NEXT_PUBLIC_PORTONE_STORE_ID=
NEXT_PUBLIC_PORTONE_IDV_CHANNEL_KEY=

# 웹 주소 CORS 허용 (쉼표로 여러 개)
ALLOWED_ORIGINS=
# 앱(Capacitor)이 부를 서버 주소, 예: https://dating-app.vercel.app
NEXT_PUBLIC_API_BASE=
